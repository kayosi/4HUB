# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Browser origin allowed to call the API (CORS + CSRF origin check)
WEB_ORIGIN=http://localhost:5173
# Matches docker-compose.yml (local dev only; use a managed secret in production)
DATABASE_URL=postgres://fourhub:change-me-locally@localhost:5432/fourhub
SESSION_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
LOG_LEVEL=info
# Max login/register/reset attempts per minute per IP
AUTH_RATE_LIMIT_MAX=10
# Optional: used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Private chart-image storage (never served statically). Relative paths resolve from the repo root.
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=5
