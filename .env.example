# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Browser origin allowed to call the API (CORS + CSRF origin check)
WEB_ORIGIN=http://localhost:5173
# Matches docker-compose.yml (local dev only; use a managed secret in production)
DATABASE_URL=postgres://fourhub:change-me-locally@localhost:5432/fourhub
SESSION_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30
LOG_LEVEL=info
# Max login/register/reset attempts per minute per IP
AUTH_RATE_LIMIT_MAX=10
# Optional: used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Private chart-image storage (never served statically). Relative paths resolve from the repo root.
UPLOAD_DIR=.data/uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------- billing
# Comma-separated list of enabled payment methods: mpesa, card, mock.
# "mock" is a sandbox for development/tests; the server REFUSES to start with it in production.
PAYMENT_PROVIDERS=mock
SUBSCRIPTION_GRACE_DAYS=3
BILLING_RATE_LIMIT_MAX=10
# Public URLs: checkout return pages (web) and provider callbacks (API). Must be https in production.
WEB_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
MOCK_PROVIDER_SECRET=dev-only-sandbox-secret
# M-Pesa (Safaricom Daraja STK push). Callback URL = API_PUBLIC_URL/api/webhooks/payments/mpesa?token=<MPESA_CALLBACK_TOKEN>
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=
# Card payments via Paystack hosted checkout. Webhook URL = API_PUBLIC_URL/api/webhooks/payments/card
PAYSTACK_SECRET_KEY=
# Community chat (live updates use Server-Sent Events; single API instance, see README)
CHAT_WRITES_PER_MINUTE=20
CHAT_MAX_STREAMS_PER_USER=5
CHAT_STREAM_RECHECK_MS=20000
# Community moderation: reports allowed per person
REPORTS_PER_HOUR=10
REPORTS_PER_DAY=30
